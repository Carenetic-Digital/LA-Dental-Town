---
import BaseLayout from '../../layouts/BaseLayout.astro';

const seoTitle = 'Financial & Insurance | LA Dental Town — East Los Angeles, CA';
const seoDescription = 'LA Dental Town accepts most PPO insurances and Denti-Cal, and offers flexible financing through Alphaeon Credit, CareCredit, and Cherry.';

// Generic financing/credit-card icon shared across partner cards.
// No third-party logos are used — brand logos for these partners are not
// yet licensed/provided, so cards are text-based per design direction.
const financingIcon = `<path d="M20 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>`;

const financingPartners = [
  {
    name: 'Alphaeon Credit',
    description: 'A healthcare credit card designed to help cover treatment costs with flexible monthly payment plans.',
    applyHref: 'https://go.alphaeoncredit.com/credit-portal/apply/wizard?ref=pr-fi&',
  },
  {
    name: 'CareCredit',
    description: 'A widely accepted healthcare credit card that lets you pay for care over time, often with promotional financing.',
    applyHref: 'https://go.carecredit.com/consumer/payfone',
  },
  {
    name: 'Cherry',
    description: 'A simple, fast financing option with a quick online application and flexible payment plans for dental care.',
    applyHref: 'https://pay.withcherry.com/la-dental-town?utm_source=merchant&utm_medium=qr_code_sticker&utm_campaign=v1',
  },
];
---

<BaseLayout title={seoTitle} description={seoDescription}>

  <!-- ──────────────────────────────────────────────────────────────────────
       Intro / Page Header
  ─────────────────────────────────────────────────────────────────────── -->
  <section class="bg-cream py-16 sm:py-20 lg:py-24" aria-label="Financial & Insurance">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="font-body text-xs uppercase tracking-widest text-green-mid mb-3">Patient Resources</p>
      <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-green-dark mb-6 leading-tight">
        Financial &amp; Insurance
      </h1>
      <p class="font-body text-base sm:text-lg text-ink/65 leading-relaxed max-w-2xl mx-auto">
        Quality dental care should be accessible. Here's how we work with insurance and the flexible financing options available to help you get the care you need.
      </p>
    </div>
  </section>

  <!-- ──────────────────────────────────────────────────────────────────────
       Insurance We Accept
  ─────────────────────────────────────────────────────────────────────── -->
  <section class="bg-white py-20 sm:py-28" aria-labelledby="insurance-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <p class="font-body text-xs uppercase tracking-widest text-green-mid mb-3">Insurance</p>
          <h2 id="insurance-heading" class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-green-dark mb-6 leading-tight">
            We Work With Your Insurance
          </h2>
          <p class="font-body text-base text-ink/70 leading-relaxed mb-5">
            LA Dental Town accepts most PPO insurances and Denti-Cal. Our team is happy to help you understand your benefits, verify coverage before treatment, and estimate your out-of-pocket costs.
          </p>
          <p class="font-body text-base text-ink/70 leading-relaxed mb-5">
            Insurance plans and coverage details vary, so we recommend giving our office a call to confirm your specific plan is accepted before your visit.
          </p>
          <p class="font-body text-sm text-ink/70">
            Questions about your coverage? Call us at <a href="tel:+13238870088" class="font-semibold text-green-mid hover:text-green-dark">(323) 887-0088</a>.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="bg-cream rounded-2xl p-6 border border-neutral-200 flex flex-col gap-2 col-span-2">
            <div class="w-12 h-12 rounded-xl bg-green-dark/10 flex items-center justify-center shrink-0 mb-2">
              <svg class="w-6 h-6 text-green-dark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
              </svg>
            </div>
            <p class="font-display font-semibold text-lg text-green-dark">Most PPO Insurance Plans</p>
            <p class="font-body text-sm text-ink/70 leading-snug">We work with most major PPO dental insurance providers.</p>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-neutral-200 flex flex-col gap-2 col-span-2">
            <div class="w-12 h-12 rounded-xl bg-green-dark/10 flex items-center justify-center shrink-0 mb-2">
              <svg class="w-6 h-6 text-green-dark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 3H5c-1.1 0-1.99.9-1.99 2L3 19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 11h-4v4h-2v-4H7v-2h4V8h2v4h4v2z"/>
              </svg>
            </div>
            <p class="font-display font-semibold text-lg text-green-dark">Denti-Cal Accepted</p>
            <p class="font-body text-sm text-ink/70 leading-snug">We proudly accept Denti-Cal for qualifying patients and families.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────────────────────────────────────────────────────────────────────
       Financing Options
  ─────────────────────────────────────────────────────────────────────── -->
  <section class="bg-cream py-20 sm:py-28" aria-labelledby="financing-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="font-body text-xs uppercase tracking-widest text-green-mid mb-3">Financing</p>
        <h2 id="financing-heading" class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-green-dark mb-5">
          Flexible Financing Options
        </h2>
        <p class="font-body text-base sm:text-lg text-ink/70 max-w-2xl mx-auto leading-relaxed">
          No insurance, or need help covering out-of-pocket costs? We offer flexible payment plans through three trusted financing partners.
        </p>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-3 gap-5 list-none m-0 p-0">
        {financingPartners.map((partner) => (
          <li class="flex flex-col gap-4 p-7 rounded-2xl border border-neutral-200 hover:border-green-mid/40 hover:shadow-xl transition-all duration-200 h-full bg-white">
            <div class="w-14 h-14 rounded-xl bg-green-dark/10 flex items-center justify-center shrink-0" aria-hidden="true">
              <svg class="w-7 h-7 text-green-dark" viewBox="0 0 24 24" fill="currentColor" set:html={financingIcon}></svg>
            </div>
            <h3 class="font-display font-semibold text-xl text-green-dark leading-tight">{partner.name}</h3>
            <p class="font-body text-sm text-ink/70 leading-relaxed flex-grow">{partner.description}</p>
            <a
              href={partner.applyHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-green-mid hover:bg-green-dark text-white font-body font-semibold text-sm px-6 py-3 rounded-full transition-colors duration-200"
              aria-label={`Apply with ${partner.name} (opens in a new tab)`}>
              Apply Now
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </li>
        ))}
      </ul>

      <p class="text-center font-body text-xs text-ink/70 mt-8 max-w-2xl mx-auto">
        Applications open in a new tab on each partner's site. Call our office if you'd like help applying.
      </p>
    </div>
  </section>

  <!-- ──────────────────────────────────────────────────────────────────────
       CTA
  ─────────────────────────────────────────────────────────────────────── -->
  <section class="bg-teal-dark text-white py-16 sm:py-20" aria-labelledby="cta-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 id="cta-heading" class="font-display font-bold text-2xl sm:text-3xl lg:text-4xl text-white mb-5 leading-tight">
        Questions About Coverage or Payment?
      </h2>
      <p class="font-body text-base text-white/75 leading-relaxed mb-8 max-w-2xl mx-auto">
        Our team is happy to walk you through your insurance benefits and financing options before you book. Give us a call — we're here to help.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/appointments/" class="inline-flex items-center gap-2 bg-green-mid hover:bg-green-dark text-white font-body font-semibold px-8 py-3.5 rounded-full transition-colors duration-200">
          Book Appointment
        </a>
        <a href="tel:+13238870088" class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-body font-medium px-8 py-3.5 rounded-full transition-colors duration-200">
          Call (323) 887-0088
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
