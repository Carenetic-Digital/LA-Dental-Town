---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import RelatedServiceGrid from '../../components/RelatedServiceGrid.astro';
import ServiceCTA from '../../components/ServiceCTA.astro';
import { ICONS, CATEGORY_COLORS } from '../../lib/serviceIcons';

const seoTitle = 'Oral Surgery | LA Dental Town';
const seoDescription = 'Expert oral surgery in East Los Angeles, including wisdom teeth removal and extractions, from the on-staff oral surgeon at LA Dental Town.';

const related = [
  {
    title: 'Wisdom Teeth',
    description: 'The most common reason patients see our oral surgeon — evaluated with digital X-rays.',
    href: '/services/wisdom-teeth/',
    icon: ICONS.tooth,
    ...CATEGORY_COLORS.oralSurgery,
  },
];
---

<BaseLayout title={seoTitle} description={seoDescription}>

  <ServiceHero
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services/' }, { label: 'Oral Surgery' }]}
    eyebrow="Category"
    title="Oral Surgery"
    description="From impacted wisdom teeth to extractions that are too complex for a general dentist, oral surgery addresses issues below the surface — often preventing pain, infection, and crowding before they become bigger problems."
    icon={ICONS.surgery}
    iconColor={CATEGORY_COLORS.oralSurgery.iconColor}
    bgColor={CATEGORY_COLORS.oralSurgery.bgColor}
  />

  <section class="bg-white py-16 sm:py-20" aria-labelledby="overview-heading">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="overview-heading" class="font-display font-bold text-2xl sm:text-3xl text-green-dark mb-6">
        Specialized Care, Without a Referral Out
      </h2>
      <div class="space-y-5 font-body text-base text-ink/70 leading-relaxed">
        <p>
          Some procedures — impacted wisdom teeth, difficult extractions, teeth that have broken below the gumline — call for a level of surgical training beyond routine dental care. Rather than referring these cases to an outside specialist, LA Dental Town has an oral surgeon on staff, so treatment can happen in the same office where your records and history already live.
        </p>
        <p>
          Left untreated, issues like impacted wisdom teeth can lead to crowding, infection, or damage to nearby teeth, so addressing them promptly tends to be easier — and less invasive — than waiting.
        </p>
      </div>
    </div>
  </section>

  <RelatedServiceGrid
    heading="Treatments Under This Category"
    items={related}
    background="cream"
  />

  <ServiceCTA />

</BaseLayout>
