---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/StructuredData.astro';

const seoTitle = "Why You Shouldn't Skip Your Biannual Dental Cleaning | LA Dental Town Blog";
const seoDescription = "Brushing and flossing can't reach everything. LA Dental Town explains why twice-yearly cleanings and exams matter for catching problems early.";

const postTitle = "Why You Shouldn't Skip Your Biannual Dental Cleaning and Checkup";
const publishDate = '2025-06-01';
const displayDate = 'June 1, 2025';
const tag = 'Preventive Care';

const relatedPosts = [
  { title: "I Brush My Teeth a Lot: Why Aren't They Staying White?", href: '/blog/i-brush-my-teeth-a-lot-why-arent-they-staying-white/', gradient: '#3A7D44, #C9A84C' },
  { title: 'When Is Wisdom Teeth Removal a Must?', href: '/blog/when-is-wisdom-teeth-removal-a-must/', gradient: '#163232, #1D4D2F' },
  { title: '5 Signs That You May Need a Root Canal', href: '/blog/5-signs-that-you-may-need-a-root-canal/', gradient: '#1D4D2F, #3A7D44' },
];

const articleData = {
  headline: postTitle,
  datePublished: publishDate,
  author: { '@type': 'Organization', name: 'LA Dental Town' },
  publisher: { '@type': 'Organization', name: 'LA Dental Town' },
  mainEntityOfPage: new URL('/blog/why-you-shouldnt-skip-your-biannual-dental-cleaning-and-checkup/', Astro.site).href,
};
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <StructuredData type="BlogPosting" data={articleData} />

  <section class="bg-cream py-16 sm:py-20" aria-label="Article header">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/blog/" class="inline-flex items-center gap-1.5 font-body text-sm font-semibold text-green-mid hover:text-green-dark transition-colors mb-6">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Blog
      </a>
      <span class="inline-block font-body text-xs font-semibold text-white bg-green-mid rounded-full px-3 py-1 mb-5">{tag}</span>
      <h1 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-green-dark leading-tight mb-4">
        {postTitle}
      </h1>
      <p class="font-body text-sm text-ink/50">
        <time datetime={publishDate}>{displayDate}</time> · LA Dental Town
      </p>
    </div>
  </section>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 -mt-2 mb-2">
    <div class="h-56 sm:h-72 rounded-2xl" style="background: linear-gradient(135deg, #1D4D2F, #3A7D44)" aria-hidden="true"></div>
  </div>

  <section class="bg-white py-14 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="font-body text-base sm:text-lg text-ink/80 leading-relaxed">
        <p class="mb-5">
          Life gets hectic, and a visit to your dentist might seem like a small thing to postpone — especially when your schedule is already packed. But these biannual appointments are necessary to keep your teeth and gums healthy.
        </p>
        <p class="mb-5">
          Prioritizing your oral health doesn't have to be stressful. At LA Dental Town in East Los Angeles, California, our expert team strives to make your visits as comfortable and convenient as possible.
        </p>
        <p class="mb-5">
          If you're tempted to put off your next dental cleaning and exam, you may want to think twice. Here, we explain why you shouldn't skip these important checkups.
        </p>

        <h2 class="font-display font-semibold text-2xl text-green-dark mt-10 mb-4">A deeper level of clean</h2>
        <p class="mb-5">
          Think your brushing and flossing routine is enough to keep your smile sparkling? You may be meticulous, but at-home care can't measure up to a professional dental cleaning.
        </p>
        <p class="mb-5">
          Plaque and cavity-causing bacteria can easily build up in areas that are difficult to reach with just your toothbrush and floss. These deposits cling to gum lines, molar grooves, and spaces between crowded teeth.
        </p>
        <p class="mb-5">
          When plaque hardens into tartar, it traps bacteria and irritates gums, contributing to periodontitis, decay, and other complications. Professional cleanings remove what brushing alone cannot.
        </p>

        <h2 class="font-display font-semibold text-2xl text-green-dark mt-10 mb-4">Catching problems early</h2>
        <p class="mb-5">
          Twice-yearly checkups enable early detection of gum disease, decay, and oral cancer. Annual X-rays reveal subsurface issues like decay between teeth and bone loss, preventing small concerns from becoming costly procedures.
        </p>

        <h2 class="font-display font-semibold text-2xl text-green-dark mt-10 mb-4">More than just a healthy smile</h2>
        <p class="mb-5">
          Research demonstrates connections between poor oral hygiene and serious conditions like heart disease and pneumonia. Regular dental visits provide personalized guidance on brushing, flossing, and cosmetic treatments unavailable elsewhere.
        </p>
      </div>

      <div class="mt-14 bg-cream border border-neutral-200 rounded-2xl p-8 text-center">
        <h3 class="font-display font-semibold text-xl text-green-dark mb-2">Don't put off your next cleaning</h3>
        <p class="font-body text-sm text-ink/60 mb-6 max-w-md mx-auto">
          Walk-ins welcome. Se Habla Español. Book online or call our office to schedule your checkup.
        </p>
        <a href="/contents/appointments/" class="inline-flex items-center gap-2 bg-green-mid hover:bg-green-dark text-white font-body font-semibold px-7 py-3.5 rounded-full transition-colors duration-200">
          Book an Appointment
        </a>
      </div>
    </div>
  </section>

  <section class="bg-cream py-14 sm:py-20" aria-labelledby="related-heading">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="related-heading" class="font-display font-bold text-2xl sm:text-3xl text-green-dark mb-8">Related Articles</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-3 gap-6 list-none m-0 p-0">
        {relatedPosts.map((post) => (
          <li>
            <a href={post.href} class="group block rounded-2xl bg-white border border-neutral-200 hover:border-green-mid/40 hover:shadow-xl overflow-hidden transition-all duration-200 h-full">
              <div class="h-32 rounded-t-2xl" style={`background: linear-gradient(135deg, ${post.gradient})`} aria-hidden="true"></div>
              <div class="p-5">
                <h3 class="font-display font-semibold text-sm text-green-dark leading-snug group-hover:text-green-mid transition-colors line-clamp-3">
                  {post.title}
                </h3>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>
