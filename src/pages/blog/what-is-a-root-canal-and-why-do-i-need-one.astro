---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/StructuredData.astro';

const title = 'What Is a Root Canal and Why Do I Need One?';
const seoTitle = `${title} | LA Dental Town Blog`;
const seoDescription = 'Modern root canals are quick and comfortable. Learn what the procedure involves and the warning signs of a tooth infection at LA Dental Town.';

const tag = 'Endodontics';

const relatedPosts = [
  {
    title: 'Are You a Candidate for Dental Implants?',
    href: '/blog/are-you-a-candidate-for-dental-implants/',
    tag: 'Implants',
  },
  {
    title: 'How Veneers Can Fix Chips, Gaps, and Discoloration for a Perfect Smile',
    href: '/blog/how-veneers-can-fix-chips-gaps-and-discoloration-for-a-perfect-smile/',
    tag: 'Cosmetic',
  },
  {
    title: 'Why Same-Day Crowns Are the Best Option for Busy Professionals',
    href: '/blog/why-same-day-crowns-are-the-best-option-for-busy-professionals/',
    tag: 'Restorative',
  },
];

const publishDate = '2026-02-11';
const displayDate = 'Feb 11, 2026';

const breadcrumbData = {
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};

const articleData = {
  headline: title,
  datePublished: publishDate,
  author: { '@type': 'Organization', name: 'LA Dental Town' },
  publisher: { '@type': 'Organization', name: 'LA Dental Town' },
  mainEntityOfPage: new URL('/blog/what-is-a-root-canal-and-why-do-i-need-one/', Astro.site).href,
};
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <StructuredData type="BreadcrumbList" data={breadcrumbData} />
  <StructuredData type="BlogPosting" data={articleData} />

  <section class="bg-cream py-14 sm:py-20" aria-label="Blog post header">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 font-body text-sm text-ink/70 list-none m-0 p-0">
          <li><a href="/blog/" class="hover:text-green-mid transition-colors">Blog</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink/70">{tag}</li>
        </ol>
      </nav>
      <span class="inline-block font-body text-xs font-semibold text-white bg-green-mid rounded-full px-3 py-1 mb-5">{tag}</span>
      <h1 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-green-dark leading-tight">
        {title}
      </h1>
      <p class="font-body text-sm text-ink/70 mt-4">
        <time datetime={publishDate}>{displayDate}</time> · LA Dental Town
      </p>
    </div>
  </section>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 -mt-2 sm:-mt-4">
    <picture>
      <source srcset="/images/blog/what-is-a-root-canal-and-why-do-i-need-one.webp" type="image/webp" />
      <img
        src="/images/blog/what-is-a-root-canal-and-why-do-i-need-one.jpg"
        alt={title}
        width="900"
        height="600"
        loading="eager"
        fetchpriority="high"
        class="w-full h-48 sm:h-64 rounded-3xl object-cover"
      />
    </picture>
  </div>

  <article class="bg-white py-14 sm:py-20">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="font-body text-base sm:text-lg text-ink/80 leading-relaxed space-y-6">
        <p>
          Few dental treatments have a more intimidating reputation than the root canal, which many people assume is a painful, complex ordeal. However, modern root canals offer a quick and virtually painless way to address a tooth infection and keep your natural smile intact.
        </p>
        <p>
          At LA Dental Town, the team is changing the way patients think about root canals. They specialize in gentle, efficient procedures, ensuring patient comfort with options like oral sedation and nitrous oxide.
        </p>
        <p>
          Don't let fear or outdated myths hold you back from necessary dental care.
        </p>

        <h2 class="font-display font-semibold text-xl sm:text-2xl text-green-dark !mt-12 !mb-2">Understanding root canals</h2>
        <p>
          This common dental procedure addresses damaged or inflamed tooth pulp — the spongy, nerve-filled tissue found at the center of each tooth, below the dentin and enamel layers. When a deep cavity or crack exposes the pulp, bacteria can invade, triggering painful inflammation within the tooth.
        </p>
        <p>
          During the procedure, the infected pulp is removed and the spaces left behind are thoroughly cleaned. The area is then filled with a rubbery dental material to provide stability and seal the tooth to keep out new bacteria.
        </p>
        <p>
          A successful root canal eliminates pain, preserves the structural integrity of your smile, and prevents the need for more costly, complex dental work.
        </p>

        <h2 class="font-display font-semibold text-xl sm:text-2xl text-green-dark !mt-12 !mb-2">The warning signs of infection</h2>
        <p>
          It's easy to miss a tooth infection in its initial stages. The damage progresses slowly, and early symptoms may be dismissed as tooth sensitivity or irritation. But the longer you wait to address the issue, the more you risk losing the opportunity to save your tooth.
        </p>
        <p>Warning signs you may need a root canal include:</p>
        <ul class="list-disc pl-6 space-y-3 marker:text-green-mid">
          <li><strong class="text-ink">Persistent pain:</strong> Deep, throbbing pain is one of the most common signs of a tooth infection. The discomfort may spread into your face or jaw, and it typically intensifies when you chew or apply pressure to the tooth.</li>
          <li><strong class="text-ink">Lingering sensitivity:</strong> While some temperature sensitivity is normal, a healthy tooth should recover almost instantly. If that ache lingers for several minutes or more after consuming hot or cold foods or beverages, it signals a deeper issue.</li>
          <li><strong class="text-ink">Swollen, tender gums:</strong> Inflammation in your gums could indicate that a tooth infection is beginning to spread to the surrounding tissue. You may notice swelling or tenderness near the affected tooth or a pimple-like, pus-filled boil on the gums.</li>
          <li><strong class="text-ink">Tooth discoloration:</strong> An untreated infection gradually kills the pulp by cutting off the tooth's internal blood supply. As the dead tissue breaks down, it stains the tooth from the inside out, causing the enamel to take on a dark or grayish tint.</li>
        </ul>

        <h2 class="font-display font-semibold text-xl sm:text-2xl text-green-dark !mt-12 !mb-2">Don't wait to save your tooth</h2>
        <p>
          If you notice any of these symptoms, see the LA Dental Town team as soon as possible. Without prompt treatment, the infection can spread to your jawbone and beyond, potentially resulting in serious systemic issues.
        </p>
        <p>
          Modern root canals are no more painful than getting a filling. While you might experience some mild sensitivity afterward as your mouth heals, any discomfort should be manageable and clear up within a week.
        </p>
        <p>
          Don't put your oral health on the back burner — act today to protect your smile. Contact LA Dental Town in East Los Angeles, California, to schedule an appointment and receive expert care in a comfortable, relaxed setting.
        </p>
      </div>

      <div class="mt-14 bg-cream border border-neutral-200 rounded-2xl p-8 sm:p-10 text-center">
        <h2 class="font-display font-semibold text-2xl text-green-dark mb-3">Experiencing Tooth Pain?</h2>
        <p class="font-body text-ink/70 mb-6">Don't wait — schedule an appointment for gentle, efficient root canal care.</p>
        <a href="/contents/appointments/" class="inline-flex items-center gap-2 bg-green-mid hover:bg-green-dark text-white font-body font-semibold px-8 py-3.5 rounded-full transition-colors duration-200">
          Book an Appointment
        </a>
      </div>
    </div>
  </article>

  <section class="bg-cream py-16 sm:py-20" aria-labelledby="related-heading">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="related-heading" class="font-display font-bold text-2xl sm:text-3xl text-green-dark mb-10 text-center">
        Related Reading
      </h2>
      <ul class="grid grid-cols-1 sm:grid-cols-3 gap-6 list-none m-0 p-0">
        {relatedPosts.map((post) => (
          <li>
            <a href={post.href} class="group block rounded-2xl bg-white border border-neutral-200 hover:border-green-mid/40 hover:shadow-xl overflow-hidden transition-all duration-200 h-full">
              <div class="relative h-32">
                <picture>
                  <source srcset={`/images/blog/${post.href.split('/').filter(Boolean).pop()}.webp`} type="image/webp" />
                  <img
                    src={`/images/blog/${post.href.split('/').filter(Boolean).pop()}.jpg`}
                    alt={post.title}
                    width="900"
                    height="600"
                    loading="lazy"
                    class="absolute inset-0 w-full h-full object-cover"
                  />
                </picture>
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" aria-hidden="true"></div>
                <span class="absolute bottom-4 left-4 inline-block font-body text-xs font-semibold text-white bg-white/20 backdrop-blur-sm rounded-full px-3 py-1">{post.tag}</span>
              </div>
              <div class="p-5">
                <h3 class="font-display font-semibold text-sm text-green-dark leading-snug group-hover:text-green-mid transition-colors line-clamp-3">{post.title}</h3>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>
