---
import BaseLayout from '../../layouts/BaseLayout.astro';

const seoTitle = 'Book an Appointment | LA Dental Town — East Los Angeles, CA';
const seoDescription = 'Schedule your visit at LA Dental Town in East Los Angeles. Call us directly to book — online booking is coming soon.';
---

<BaseLayout title={seoTitle} description={seoDescription}>

  <!-- ──────────────────────────────────────────────────────────────────────
       SECTION 1: Page Intro
  ─────────────────────────────────────────────────────────────────────── -->
  <section class="bg-cream py-20 sm:py-28" aria-labelledby="appointments-hero-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="font-body text-xs uppercase tracking-widest text-green-mid mb-3">Appointments</p>
      <h1 id="appointments-hero-heading" class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-green-dark mb-6 leading-tight">
        Book Your Appointment
      </h1>
      <p class="font-body text-lg sm:text-xl text-ink/65 leading-relaxed">
        Walk-ins welcome. Se Habla Español. Call our East Los Angeles office and we'll find a time that works for your whole family.
      </p>
    </div>
  </section>


  <!-- ──────────────────────────────────────────────────────────────────────
       SECTION 2: Call to Book (available now)
  ─────────────────────────────────────────────────────────────────────── -->
  <section class="bg-white py-16 sm:py-20" aria-labelledby="call-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-teal-dark text-white rounded-3xl p-8 sm:p-12 text-center">
        <div class="inline-flex items-center gap-2 bg-white/10 rounded-full px-4 py-2 mb-6">
          <span class="font-body text-xs uppercase tracking-widest text-white/80">Available Now</span>
        </div>
        <h2 id="call-heading" class="font-display font-bold text-2xl sm:text-3xl lg:text-4xl text-white mb-4 leading-tight">
          Book by Phone
        </h2>
        <p class="font-body text-base text-white/75 leading-relaxed max-w-xl mx-auto mb-8">
          The fastest way to schedule is to call our office directly. Our team can find an appointment time that works for you and answer any questions about insurance or services.
        </p>
        <a
          href="tel:+13238870088"
          class="inline-flex items-center gap-3 bg-white text-teal-dark hover:bg-cream font-body font-bold text-xl sm:text-2xl px-8 py-4 rounded-full transition-colors duration-200">
          <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
          (323) 887-0088
        </a>
        <p class="font-body text-sm text-white/60 mt-6">
          Monday–Friday: 8:30am – 5:30pm &nbsp;·&nbsp; Saturday–Sunday: Closed
        </p>
      </div>
    </div>
  </section>


  <!-- ──────────────────────────────────────────────────────────────────────
       SECTION 3: Book Online (placeholder — widget pending)
  ─────────────────────────────────────────────────────────────────────── -->
  <section class="bg-cream py-16 sm:py-20" aria-labelledby="online-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <p class="font-body text-xs uppercase tracking-widest text-green-mid mb-3">Coming Soon</p>
        <h2 id="online-heading" class="font-display font-bold text-2xl sm:text-3xl lg:text-4xl text-green-dark mb-4 leading-tight">
          Book Online
        </h2>
        <p class="font-body text-base text-ink/70 max-w-xl mx-auto leading-relaxed">
          We're integrating an online booking widget so you'll soon be able to schedule your visit right from this page. In the meantime, please call us to book.
        </p>
      </div>

      <!-- TODO: embed booking widget once Norma provides integration code and confirms practice management software -->
      <div class="rounded-3xl border-2 border-dashed border-green-mid/30 bg-white/60 p-10 sm:p-14 flex flex-col items-center justify-center text-center gap-4" role="status" aria-label="Online booking placeholder — widget coming soon">
        <div class="w-14 h-14 rounded-full bg-green-dark/10 flex items-center justify-center">
          <svg class="w-7 h-7 text-green-dark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11zM7 11h5v5H7z"/>
          </svg>
        </div>
        <p class="font-display font-semibold text-lg text-green-dark">Online booking widget placeholder</p>
        <p class="font-body text-sm text-ink/70 max-w-sm leading-relaxed">
          This space will hold our live booking widget once it's ready. It isn't functional yet — please call to schedule.
        </p>
        <a href="tel:+13238870088" class="inline-flex items-center gap-2 bg-green-mid hover:bg-green-dark text-white font-body font-semibold px-6 py-3 rounded-full transition-colors duration-200 text-sm">
          Call (323) 887-0088 to Book
        </a>
      </div>
    </div>
  </section>


  <!-- ──────────────────────────────────────────────────────────────────────
       SECTION 4: Contact Repeat / Closing
  ─────────────────────────────────────────────────────────────────────── -->
  <section class="bg-teal-dark text-white py-16 sm:py-20" aria-labelledby="appointments-cta-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 id="appointments-cta-heading" class="font-display font-bold text-2xl sm:text-3xl lg:text-4xl text-white mb-5 leading-tight">
        Questions Before You Book?
      </h2>
      <p class="font-body text-base text-white/75 leading-relaxed max-w-2xl mx-auto mb-3">
        Most PPO insurances and Denti-Cal accepted. We also offer flexible financing through Alphaeon Credit, CareCredit, and Cherry.
      </p>
      <p class="font-body text-sm text-white/60 mb-8">
        5262 E Beverly Blvd, East Los Angeles, CA 90022 &nbsp;·&nbsp; Mon–Fri: 8:30am – 5:30pm
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="tel:+13238870088" class="bg-green-mid hover:bg-green-dark text-white font-body font-semibold px-8 py-4 rounded-full transition-colors duration-200">
          Call (323) 887-0088
        </a>
        <a href="/contactus/" class="border-2 border-white/40 hover:border-white text-white font-body font-medium px-8 py-4 rounded-full transition-all duration-200">
          Contact Us
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
