---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BeforeAfterCard from '../../components/BeforeAfterCard.astro';

const seoTitle = 'Before & After Photos | LA Dental Town — East Los Angeles, CA';
const seoDescription = 'See real before-and-after results from LA Dental Town patients — 47 transformations from our general, cosmetic & restorative dentistry.';

// Actual pixel dimensions of each source photo, verified with `sips -g pixelWidth -g pixelHeight`
// against public/images/before-after/case-NN-before.jpg / case-NN-after.jpg.
// Explicit width/height on every <img> prevents layout shift regardless of each
// photo's native aspect ratio (they vary case to case since these are real,
// unstaged clinical photos).
const cases = [
  { n: '01', bw: 529, bh: 189, aw: 515, ah: 193 },
  { n: '02', bw: 524, bh: 191, aw: 517, ah: 193 },
  { n: '03', bw: 558, bh: 185, aw: 559, ah: 190 },
  { n: '04', bw: 544, bh: 188, aw: 546, ah: 188 },
  { n: '05', bw: 537, bh: 251, aw: 537, ah: 251 },
  { n: '06', bw: 512, bh: 263, aw: 524, ah: 265 },
  { n: '07', bw: 556, bh: 273, aw: 592, ah: 274 },
  { n: '08', bw: 520, bh: 186, aw: 494, ah: 168 },
  { n: '09', bw: 670, bh: 259, aw: 611, ah: 262 },
  { n: '10', bw: 593, bh: 261, aw: 638, ah: 261 },
  { n: '11', bw: 505, bh: 355, aw: 516, ah: 357 },
  { n: '12', bw: 784, bh: 251, aw: 384, ah: 251 },
  { n: '13', bw: 497, bh: 248, aw: 497, ah: 249 },
  { n: '14', bw: 420, bh: 204, aw: 421, ah: 198 },
  { n: '15', bw: 419, bh: 202, aw: 418, ah: 198 },
  { n: '16', bw: 477, bh: 297, aw: 461, ah: 291 },
  { n: '17', bw: 445, bh: 299, aw: 540, ah: 300 },
  { n: '18', bw: 443, bh: 266, aw: 497, ah: 258 },
  { n: '19', bw: 316, bh: 159, aw: 271, ah: 235 },
  { n: '20', bw: 587, bh: 171, aw: 538, ah: 165 },
  { n: '21', bw: 467, bh: 235, aw: 473, ah: 235 },
  { n: '22', bw: 364, bh: 232, aw: 364, ah: 232 },
  { n: '23', bw: 364, bh: 232, aw: 364, ah: 232 },
  { n: '24', bw: 516, bh: 164, aw: 767, ah: 164 },
  { n: '25', bw: 364, bh: 246, aw: 725, ah: 246 },
  { n: '26', bw: 364, bh: 246, aw: 725, ah: 246 },
  { n: '27', bw: 725, bh: 232, aw: 364, ah: 232 },
  { n: '28', bw: 957, bh: 244, aw: 318, ah: 243 },
  { n: '29', bw: 364, bh: 232, aw: 364, ah: 232 },
  { n: '30', bw: 457, bh: 240, aw: 462, ah: 236 },
  { n: '31', bw: 723, bh: 232, aw: 379, ah: 231 },
  { n: '32', bw: 364, bh: 232, aw: 364, ah: 232 },
  { n: '33', bw: 364, bh: 246, aw: 725, ah: 246 },
  { n: '34', bw: 364, bh: 246, aw: 725, ah: 246 },
  { n: '35', bw: 725, bh: 246, aw: 364, ah: 246 },
  { n: '36', bw: 364, bh: 246, aw: 725, ah: 246 },
  { n: '37', bw: 364, bh: 232, aw: 364, ah: 232 },
  { n: '38', bw: 364, bh: 232, aw: 364, ah: 232 },
  { n: '39', bw: 364, bh: 232, aw: 364, ah: 232 },
