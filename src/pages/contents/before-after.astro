---

<BaseLayout title={seoTitle} description={seoDescription}>

  <!-- ──────────────────────────────────────────────────────────────────────
       SECTION 1: Header / Intro
  ─────────────────────────────────────────────────────────────────────── -->
  <section class="bg-cream py-16 sm:py-20" aria-labelledby="before-after-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="font-body text-xs uppercase tracking-widest text-green-mid mb-3">Real Patient Results</p>
      <h1 id="before-after-heading" class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-green-dark mb-6 leading-tight">
        Before &amp; After
      </h1>
      <p class="font-body text-base sm:text-lg text-ink/65 leading-relaxed max-w-2xl mx-auto">
        Browse 47 real patient transformations from our East Los Angeles practice. These photos document actual treatment outcomes at LA Dental Town — individual results vary based on each patient's unique dental history, diagnosis, and treatment plan.
      </p>
    </div>
  </section>


  <!-- ──────────────────────────────────────────────────────────────────────
       SECTION 2: Gallery Grid
  ─────────────────────────────────────────────────────────────────────── -->
  <section class="bg-white py-16 sm:py-20" aria-label="Before and after photo gallery">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 list-none m-0 p-0">
        {cases.map((c) => (
          <li>
            <BeforeAfterCard
              caseNumber={c.n}
              beforeWidth={c.bw}
              beforeHeight={c.bh}
              afterWidth={c.aw}
              afterHeight={c.ah}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>


  <!-- ──────────────────────────────────────────────────────────────────────
       SECTION 3: Closing CTA
  ─────────────────────────────────────────────────────────────────────── -->
  <section class="bg-teal-dark text-white py-16 sm:py-20" aria-labelledby="cta-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white/10 rounded-3xl p-8 sm:p-12 border border-white/20 text-center">
        <h2 id="cta-heading" class="font-display font-semibold text-2xl sm:text-3xl lg:text-4xl text-white mb-4">
          Ready for Your Own Transformation?
        </h2>
        <p class="font-body text-white/75 text-base sm:text-lg leading-relaxed mb-8 max-w-xl mx-auto">
          Schedule a consultation with our team to talk through your options — walk-ins welcome, and Se Habla Español.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center max-w-md mx-auto">
          <a href="/contents/appointments/" class="flex-1 text-center bg-green-mid hover:bg-green-dark text-white font-body font-semibold py-3.5 px-7 rounded-full transition-colors duration-200">
            Book Appointment
          </a>
          <a href="tel:+13238870088" class="flex-1 text-center border-2 border-white/40 hover:border-white text-white font-body font-medium py-3.5 px-7 rounded-full transition-colors duration-200">
            Call (323) 887-0088
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
