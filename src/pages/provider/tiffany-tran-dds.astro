---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProviderHero from '../../components/ProviderHero.astro';
import ProviderBio from '../../components/ProviderBio.astro';
import ProviderCredentials from '../../components/ProviderCredentials.astro';
import ProviderDifferentiators from '../../components/ProviderDifferentiators.astro';
import ProviderCTA from '../../components/ProviderCTA.astro';
import RelatedServiceGrid from '../../components/RelatedServiceGrid.astro';
import { getProvider } from '../../lib/providers';
import { resolveServices } from '../../lib/providerServices';

const provider = getProvider('tiffany-tran-dds')!;
const services = resolveServices(provider.services);

const seoTitle = 'Tiffany Tran, DDS, MS | Pediatric Dentist | LA Dental Town';
const seoDescription = 'Meet Dr. Tiffany Tran, board-certified pediatric dentist at LA Dental Town in East Los Angeles.';
---

<BaseLayout title={seoTitle} description={seoDescription}>

  <ProviderHero
    name={provider.name}
    specialtyLine={provider.specialtyLine}
    tagline={provider.tagline}
    photoSlug={provider.photoSlug}
    initials={provider.initials}
  />

  <ProviderBio
    shortName={provider.shortName}
    hasBio={provider.hasBio}
    paragraphs={provider.bioParagraphs}
  />

  <ProviderCredentials
    shortName={provider.shortName}
    intro={provider.credentialsIntro}
    items={provider.credentialsList}
  />

  <ProviderDifferentiators />

  <ProviderCTA />

  <RelatedServiceGrid
    heading={`Services Provided by ${provider.shortName}`}
    subheading="Dr. Tiff focuses on pediatric dentistry for children from infants through young adults."
    items={services}
    background="white"
    headingId="provider-services-heading"
  />

</BaseLayout>
