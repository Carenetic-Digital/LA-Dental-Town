---
// component-builder: ProviderHero
// Purpose: Page-top hero for /provider/[slug]/ pages — breadcrumb, photo (or
// initials placeholder avatar when no photo is on file), name, specialty
// line, one-sentence tagline, and booking CTAs. Structural pattern adapted
// from the client-referenced bhdentists.com doctor bio page (see
// reference/analysis.md, "Client-Requested Reference Details" §1), rebuilt
// in our own color system.
import StructuredData from './StructuredData.astro';

interface Props {
  name: string;
  specialtyLine: string;
  tagline: string;
  photoSlug: string | null;
  initials: string;
}

const { name, specialtyLine, tagline, photoSlug, initials } = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const breadcrumbListData = {
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Providers', item: new URL('/provider/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name },
  ],
};

const physicianData = {
  name,
  medicalSpecialty: specialtyLine,
  url: pageUrl,
  ...(photoSlug ? { image: new URL(`/images/providers/${photoSlug}.jpg`, Astro.site).href } : {}),
  worksFor: {
    '@type': 'Dentist',
    name: 'LA Dental Town',
    url: Astro.site?.href,
  },
};
---

<StructuredData type="BreadcrumbList" data={breadcrumbListData} />
<StructuredData type="Physician" data={physicianData} />

<section class="bg-cream" aria-label={name}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-16 sm:pt-14 sm:pb-20">

    <nav aria-label="Breadcrumb" class="mb-10">
      <ol class="flex items-center gap-2 text-xs font-body text-ink/70 flex-wrap list-none m-0 p-0">
        <li class="flex items-center gap-2">
          <a href="/" class="hover:text-green-mid transition-colors">Home</a>
          <span aria-hidden="true">/</span>
        </li>
        <li class="flex items-center gap-2">
          <a href="/provider/" class="hover:text-green-mid transition-colors">Providers</a>
          <span aria-hidden="true">/</span>
        </li>
        <li>
          <span class="text-ink/70 font-medium" aria-current="page">{name}</span>
        </li>
      </ol>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-10 lg:gap-16 items-center">

      <!-- Photo or placeholder avatar -->
      <div class="flex flex-col items-center lg:items-start gap-3 shrink-0">
        {photoSlug ? (
          <picture>
            <source srcset={`/images/providers/${photoSlug}.webp`} type="image/webp" />
            <img
              src={`/images/providers/${photoSlug}.jpg`}
              alt={`Portrait of ${name}`}
              width="800"
              height="800"
              loading="lazy"
              class="w-56 h-56 sm:w-64 sm:h-64 rounded-3xl object-cover shadow-lg"
            />
          </picture>
        ) : (
          <>
            <div
              class="w-56 h-56 sm:w-64 sm:h-64 rounded-full bg-green-dark flex items-center justify-center shadow-lg shrink-0"
              role="img"
              aria-label={`Photo not yet available for ${name}`}>
              <span class="font-display font-bold text-white text-5xl sm:text-6xl" aria-hidden="true">{initials}</span>
            </div>
            <p class="font-body text-sm text-ink/70 italic">Photo coming soon</p>
          </>
        )}
      </div>

      <!-- Name, specialty, tagline, CTAs -->
      <div>
        <p class="font-body text-xs sm:text-sm uppercase tracking-widest text-green-mid mb-4">{specialtyLine}</p>
        <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-green-dark leading-tight mb-6">
          {name}
        </h1>
        <p class="font-body text-lg text-ink/65 leading-relaxed max-w-xl mb-9">
          {tagline}
        </p>

        <div class="flex flex-wrap gap-4">
          <a
            href="/contents/appointments/"
            class="inline-flex items-center gap-2 bg-green-dark hover:bg-green-mid text-white font-body font-semibold px-7 py-3.5 rounded-full transition-all duration-200 shadow-lg shadow-green-dark/20">
            Book Appointment
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            href="tel:+13238870088"
            class="inline-flex items-center gap-2 border-2 border-green-dark/30 hover:border-green-dark text-ink hover:text-green-dark font-body font-medium px-7 py-3.5 rounded-full transition-all duration-200">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            (323) 887-0088
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
