---
// component-builder: ProviderCredentials
// Purpose: Two-column "Education & Credentials" section for
// /provider/[slug]/ pages — a plain bulleted list (no icons/badges), per the
// client-requested bhdentists.com reference layout (reference/analysis.md,
// "Client-Requested Reference Details" §1, step 5). Only rendered on pages
// that have at least one confirmed credential fact — never invented.

interface Props {
  shortName: string;
  intro?: string;
  items: string[];
}

const { shortName, intro, items } = Astro.props;
---

<section class="bg-cream py-16 sm:py-20" aria-labelledby="credentials-heading">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] gap-10 lg:gap-16">
      <div>
        <h2 id="credentials-heading" class="font-display font-bold text-2xl sm:text-3xl text-green-dark mb-4">
          Education &amp; Credentials
        </h2>
        {intro && <p class="font-body text-base text-ink/70 leading-relaxed">{intro}</p>}
      </div>

      <ul class="space-y-4 font-body text-base text-ink/75 leading-relaxed list-disc pl-5 marker:text-green-mid">
        {items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>
