---
// component-builder: RelatedServiceGrid
// Purpose: Icon-card grid for cross-linking category <-> sub-service pages
// (and the /services/ overview page). Visual pattern matches the homepage
// services section (src/pages/index.astro) for continuity.

interface ServiceItem {
  title: string;
  description: string;
  href: string;
  icon: string;
  iconColor: string;
  bgColor: string;
}

interface Props {
  heading: string;
  subheading?: string;
  items: ServiceItem[];
  background?: 'white' | 'cream';
  headingId?: string;
}

const { heading, subheading, items, background = 'white', headingId = 'related-services-heading' } = Astro.props;
---

<section class:list={[background === 'cream' ? 'bg-cream' : 'bg-white', 'py-16 sm:py-20']} aria-labelledby={headingId}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-10 max-w-2xl">
      <h2 id={headingId} class="font-display font-bold text-2xl sm:text-3xl text-green-dark mb-3">{heading}</h2>
      {subheading && <p class="font-body text-base text-ink/60 leading-relaxed">{subheading}</p>}
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 list-none m-0 p-0">
      {items.map((s) => (
        <li>
          <a
            href={s.href}
            class="group flex flex-col gap-4 p-6 rounded-2xl border border-neutral-200 hover:border-green-mid/40 hover:shadow-xl transition-all duration-200 h-full bg-white">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style={`background-color:${s.bgColor}`}>
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill={s.iconColor} aria-hidden="true" set:html={s.icon}></svg>
              </div>
              <h3 class="font-display font-semibold text-lg text-green-dark leading-tight group-hover:text-green-mid transition-colors">
                {s.title}
              </h3>
            </div>
            <p class="font-body text-sm text-ink/60 leading-relaxed flex-grow">{s.description}</p>
            <span class="font-body text-sm font-semibold text-green-mid group-hover:gap-2 flex items-center gap-1.5 transition-all">
              Learn more
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
