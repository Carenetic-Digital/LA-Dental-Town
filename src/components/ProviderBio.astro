---
// component-builder: ProviderBio
// Purpose: Centered narrative bio section for /provider/[slug]/ pages
// ("Meet Dr. X"). Falls back to a clearly-labeled placeholder when no
// approved bio copy exists yet, rather than inventing biographical details.

interface Props {
  shortName: string;
  hasBio: boolean;
  paragraphs?: string[];
}

const { shortName, hasBio, paragraphs = [] } = Astro.props;
---

<section class="bg-white py-16 sm:py-20" aria-labelledby="bio-heading">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 id="bio-heading" class="font-display font-bold text-2xl sm:text-3xl text-green-dark mb-8">
      Meet {shortName}
    </h2>

    {hasBio ? (
      <div class="space-y-5 font-body text-base text-ink/70 leading-relaxed text-left">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
    ) : (
      <div class="bg-cream border border-neutral-200 rounded-2xl p-8 sm:p-10">
        <p class="font-body text-base text-ink/70 leading-relaxed">
          Full bio coming soon — check back shortly.
        </p>
      </div>
    )}

    <div class="mt-9">
      <a
        href="/appointments/"
        class="inline-flex items-center gap-2 border-2 border-green-dark text-green-dark hover:bg-green-dark hover:text-white font-body font-semibold px-7 py-3.5 rounded-full transition-all duration-200">
        Contact Us
      </a>
    </div>
  </div>
</section>
